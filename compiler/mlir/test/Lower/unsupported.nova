# RUN: not nova-lower %s 2>&1 | FileCheck %s
#
# What lowering does not cover yet stops it with the line and what it is, as the interpreter's lowering does.

ignite:
    # CHECK: unsupported.nova:[[@LINE+1]]:12: error[E0601]: nova-lower cannot lower a variable of type string yet
    string s = "abc"
    print(s)
