# Naive recursive Fibonacci: measures function-call overhead.
# The unreachable print makes fib impure, so automatic memoization does not
# collapse the recursion; every implementation makes the same 2.7M calls.
def fib(int n) -> int:
    if (n < 0):
        print(n)
    if (n < 2):
        return n
    return fib(n - 1) + fib(n - 2)

ignite:
    print(fib(30))
