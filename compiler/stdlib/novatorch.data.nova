class DataLoader {
    int data ;
    int labels ;
    int n_samples ;
    int batch_size ;
    int current ;

    def init(int d, int l, int bs)
    {
        self.data = d ;
        self.labels = l ;
        self.n_samples = tensor_rows(d) ;
        self.batch_size = bs ;
        self.current = 0 ;
    }

    def shuffle() {
        int i = self.n_samples - 1 ;
        while i > 0 {
            int j = tensor_get(rand_int(0, i), 0, 0) ;
            int row_i = tensor_get_row(self.data, i) ;
            int row_j = tensor_get_row(self.data, j) ;
            tensor_set_row(self.data, i, row_j) ;
            tensor_set_row(self.data, j, row_i) ;
            int lbl_i = tensor_get(self.labels, i, 0) ;
            int lbl_j = tensor_get(self.labels, j, 0) ;
            tensor_set(self.labels, i, 0, lbl_j) ;
            tensor_set(self.labels, j, 0, lbl_i) ;
            i = i - 1 ;
        }
    }

    def has_next() -> int {
        return self.current < self.n_samples ;
    }

    def next_batch_x() -> int {
        int start = self.current ;
        int end = start + self.batch_size ;
        if end > self.n_samples {
            end = self.n_samples ;
        }
        return tensor_slice_rows(self.data, start, end) ;
    }

    def next_batch_y() -> int {
        int start = self.current ;
        int end = start + self.batch_size ;
        if end > self.n_samples {
            end = self.n_samples ;
        }
        self.current = end ;
        return tensor_slice_rows(self.labels, start, end) ;
    }

    def reset() {
        self.current = 0 ;
    }
}

def normalize(int t) -> int {
    int cols = tensor_cols(t) ;
    int rows = tensor_rows(t) ;
    int out = tensor_zeros(rows, cols) ;
    int col = 0 ;
    while col < cols {
        double mn = tensor_get(t, 0, col) ;
        double mx = tensor_get(t, 0, col) ;
        int row = 1 ;
        while row < rows {
            double v = tensor_get(t, row, col);
            if v < mn { mn = v ;}
            if v > mx { mx = v ; }
            row = row + 1 ;
        }
        double range = mx - mn ;
        row = 0 ;
        while row < rows {
            double v = tensor_get(t, row, col) ;
            double norm = 0.0 ;
            if range > 0.0 {
                norm = (v - mn) / range ;
            }
            tensor_set(out, row, col, norm) ;
            row = row + 1 ;
        }
        col = col + 1 ;
    }
    return out ;
}

def one_hot(int label, int n_classes) -> int {
    int out = tensor_zeros(1, n_Classes) ;
    tensor_set(out, 0, label, 1) ;
    return out ;
}

def train_test_split(int data, int labels, double test_ratio) -> int, int, int, int {
    int n = tensor_rows(data) ;
    int n_test = int(double(n) * test_ratio) ;
    int n_train = n - n_test ;
    int x_train = tensor_slice_rows(data, 0, n_train) ;
    int y_train = tensor_slice_rows(labels, 0, n_train) ;
    int x_test = tensor_slice_rows(data, n_train, n) ;
    int y_test = tensor_slice_rows(labels, n_train, n) ;
    return x_train, y_train, x_test, y_test ;
}