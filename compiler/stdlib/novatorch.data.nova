class DataLoader:
    Tensor data
    Tensor labels
    int n_samples
    int batch_size
    int current

    def init(Tensor d, Tensor l, int bs):
        self.data = d
        self.labels = l
        self.n_samples = tensor_rows(d)
        self.batch_size = bs
        self.current = 0

    def shuffle():
        int i = self.n_samples - 1
        while (i > 0):
            int j = rand_int(0, i)
            Tensor row_i = tensor_get_row(self.data, i)
            Tensor row_j = tensor_get_row(self.data, j)
            tensor_set_row(self.data, i, row_j)
            tensor_set_row(self.data, j, row_i)
            double lbl_i = tensor_get(self.labels, i, 0)
            double lbl_j = tensor_get(self.labels, j, 0)
            tensor_set(self.labels, i, 0, lbl_j)
            tensor_set(self.labels, j, 0, lbl_i)
            i = i - 1

    def has_next() -> bool:
        return self.current < self.n_samples

    def next_batch_x() -> Tensor:
        int start = self.current
        int end = start + self.batch_size
        if (end > self.n_samples):
            end = self.n_samples
        return tensor_slice_rows(self.data, start, end)

    def next_batch_y() -> Tensor:
        int start = self.current
        int end = start + self.batch_size
        if (end > self.n_samples):
            end = self.n_samples
        self.current = end
        return tensor_slice_rows(self.labels, start, end)

    def reset():
        self.current = 0

def normalize(Tensor t) -> Tensor:
    int cols = tensor_cols(t)
    int rows = tensor_rows(t)
    Tensor out = tensor_zeros(rows, cols)
    int col = 0
    while (col < cols):
        double mn = tensor_get(t, 0, col)
        double mx = tensor_get(t, 0, col)
        int row = 1
        while (row < rows):
            double v = tensor_get(t, row, col)
            if (v < mn): mn = v
            if (v > mx): mx = v
            row = row + 1
        double range = mx - mn
        row = 0
        while (row < rows):
            double v = tensor_get(t, row, col)
            double norm = 0.0
            if (range > 0.0):
                norm = (v - mn) / range
            tensor_set(out, row, col, norm)
            row = row + 1
        col = col + 1
    return out

def one_hot(int label, int n_classes) -> Tensor:
    Tensor out = tensor_zeros(1, n_classes)
    tensor_set(out, 0, label, 1)
    return out

def train_test_split(Tensor data, Tensor labels, double test_ratio) -> Tensor, Tensor, Tensor, Tensor:
    int n = tensor_rows(data)
    int n_test = int(double(n) * test_ratio)
    int n_train = n - n_test
    Tensor x_train = tensor_slice_rows(data, 0, n_train)
    Tensor y_train = tensor_slice_rows(labels, 0, n_train)
    Tensor x_test = tensor_slice_rows(data, n_train, n)
    Tensor y_test = tensor_slice_rows(labels, n_train, n)
    return x_train, y_train, x_test, y_test
