    Tensor b = scale_all(a, 3.0)
    print(b[1, 1])
    Tensor h1, Tensor h2 = halves(b)
    print(h1[0, 0])
    print(h2[0, 0])
    print(total(b) + total(h1))
    Tensor two = a + a
    print(power(two, 4)[0, 1])
    print(make(3, 2).rows)
    print(pick(true, a, b)[0, 0])
    print(pick(false, a, b)[0, 0])
    int i = 0
    Tensor acc = zeros(2, 2)
