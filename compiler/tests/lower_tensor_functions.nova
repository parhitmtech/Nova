# Lowering tensors (2c-2a): tensors through functions: parameters, results, several results, recursion, a
# variable set on one branch, and tensors made and dropped in loops. The live count at the end is 5, as with the
# old parser: power(two, 4) leaves 3 tensors (one per recursive call) and each pick call leaves 1. These are known
# leaks of the tensor-free pass (ROADMAP phase 6).
def scale_all(Tensor t, double s) -> Tensor:
    return t * s

def halves(Tensor t) -> Tensor, Tensor:
    return t * 0.5, t - t * 0.5

def total(Tensor t) -> double:
    return tensor_sum(t)

def power(Tensor t, int n) -> Tensor:
    if (n <= 1):
        return t
    return t * power(t, n - 1)

def make(int r, int c):
    Tensor z = zeros(r, c)
    z[0, 0] = 1.0
    return z

def pick(bool first, Tensor a, Tensor b) -> Tensor:
    Tensor r
    if (first):
        r = a
    else:
        r = b
    return r

ignite:
