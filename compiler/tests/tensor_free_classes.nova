# Regression test: tensors held by class fields and passed through methods are freed exactly once.
# COvers a field store inside a method, a method that returns a field, a method that returns a new
# tensor, two instances of one class (they share the method's self slots), a method call uses as a
# method argument, and an int-returning tensor op (tensor_rows) inside a method. tensor_live_count()
# must not grow with the number of iterations.
import <novatorch.nn>

class Holder:
    Tensor t

    def init():
        pass

    def set(Tensor x):
        self.t = x

    def get() -> Tensor:
        return self.t

    def doubled() -> Tensor:
        return tensor_add(self.t, self.t)

ignite:
    Tensor base = tensor_ones(2, 2)
    Holder a
    Holder b
    int i = 0
    while (i < 50):
        Tensor x = tensor_add(base, base)
        a.set(x)
        b.set(a.doubled())
        i = i + 1
    print(tensor_get(a.get(), 0, 0))
    print(tensor_get(b.get(), 1, 1))
    # base + the tensor held by a + the tensor held by b
    print(tensor_live_count())

    # Tanh.backward calls tensor_rows/tensor_cols; their int results used to be "released" as if they
    # were tensor handles.
    Tanh th
    Tensor y = th.forward(base)
    Tensor g = th.backward(base)
    print(tensor_get(g, 0, 0))
    print(tensor_get(base, 0, 0))
