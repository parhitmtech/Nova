# Lowering generic functions (2c-5): one function per copy (ident<int>, ident<string>, getx<P>), with numbers,
# strings, tensors and objects, recursion, a switch and loops in a copy, and a generic calling a generic.
class P:
    int x

    def init(int a):
        self.x = a

    def bump() -> int:
        self.x = self.x + 1
        return self.x

def ident(v):
    return v

def add3(a, b, c):
    return a + b + c

def getx(p):
    return p.x

def mkp(n):
    return P(n)

def power(b, e):
    if (e == 0):
        return 1
    return b * power(b, e - 1)

def fpower(b, e):
    if (e == 0):
        return b / b
    return b * fpower(b, e - 1)

def classify(n):
    switch (n):
        case 1:
            return 10
        case 2:
            return 20
        default:
            return 0
    return -1

def sumto(n):
    int s = 0
    int i = 0
    while (i < n):
        s += i
        i += 1
    return s

def scaled(t, k):
    return t * k

def outer(a):
    return ident(a) + ident(a)

def bumpall(p, n):
    int i = 0
    while (i < n):
        p.bump()
        i += 1
    return p.x

def main():
    print(ident(3))
    print(ident(2.5))
    print(ident("s"))
    print(add3(1, 2, 3))
    print(add3(1.5, 2.5, 3.0))
    print(add3("a", "b", "c"))
    print(getx(P(7)))
    P q = mkp(4)
    print(q.x)
    print(getx(mkp(9)))
    print(power(2, 10))
    print(fpower(1.5, 3))
    print(classify(2))
    print(classify(5))
    print(sumto(10))
    Tensor t = scaled(ones(2, 2), 3.0)
    print(t[1, 1])
    print(outer(4))
    print(outer(1.25))
    print(bumpall(q, 3))
    print(q.x)
    int i = 0
    while (i < 5):
        P r = mkp(i)
        print(getx(r) + ident(i))
        Tensor u = scaled(ones(1, 3), 2.0)
        print(u[0, 2])
        i += 1
    print(tensor_live_count())
