# Gradients through tensor + - number in all four orders (t + k, k + t, t - k, k - t), against central
# finite differences.
def dabs(double x) -> double:
    if (x < 0.0):
        return 0.0 - x
    return x

def f(Tensor a) -> Tensor:
    return (a + 1.5) * (2.0 - a) + (3.0 + a) * (a - 0.5)

def main():
    double eps = 0.0001
    Tensor a = zeros(2, 2)
    a[0, 0] = 1.0
    a[0, 1] = -2.0
    a[1, 0] = 0.5
    a[1, 1] = 3.0
    Tensor t = zeros(2, 2)
    t[0, 0] = 0.3
    t[1, 1] = -0.7

    requires_grad(a)
    backward(mse_loss(f(a), t))
    Tensor g = tensor_grad(a)

    double worst = 0.0
    int i = 0
    int j = 0
    for (i = 0 ; i < 2 ; i += 1):
        for (j = 0 ; j < 2 ; j += 1):
            double orig = a[i, j]
            a[i, j] = orig + eps
            double lp = mse_loss(f(a), t)[0, 0]
            a[i, j] = orig - eps
            double lm = mse_loss(f(a), t)[0, 0]
            a[i, j] = orig
            double d = dabs((lp - lm) / (2.0 * eps) - g[i, j])
            if (d > worst): worst = d
    if (worst < 0.001): print("PASS add_scalar")
    else: print("FAIL add_scalar")
