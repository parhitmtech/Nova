# tensor_reshape keeps the elements in order, infers one -1 dimension and supports N-D shapes.
ignite:
    int a = tensor_ones(3, 4)
    tensor_set(a, 0, 1, 7.0)
    int b = tensor_reshape(a, 2, 6)
    print(tensor_rank(b))
    print(tensor_dim(b, 0))
    print(tensor_dim(b, 1))
    print(tensor_get(b, 0, 1))
    int c = tensor_reshape(a, -1, 3)
    print(tensor_dim(c, 0))
    print(tensor_dim(c, 1))
    int d = tensor_reshape(a, 2, 3, 2)
    print(tensor_rank(d))
