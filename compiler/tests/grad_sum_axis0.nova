def dabs(double x) -> double {
    if (x < 0.0) {
        return 0.0 - x ;
    }
    return x ;
}

ignite {
    double eps = 0.0001 ;
    double tol = 0.001 ;
    double maxdiff = 0.0 ;
    double d = 0.0 ;

    // ── sum_axis0 (tensor_sum_rows): NxM -> 1xM ───────────────────────────
    int saA = tensor_zeros(2, 3) ;
    tensor_set(saA, 0, 0, 1.0) ;
    tensor_set(saA, 0, 1, (0.0 - 2.0)) ;
    tensor_set(saA, 0, 2, 0.5) ;
    tensor_set(saA, 1, 0, 0.3) ;
    tensor_set(saA, 1, 1, 1.2) ;
    tensor_set(saA, 1, 2, (0.0 - 0.8)) ;
    int saT = tensor_zeros(1, 3) ;
    tensor_set(saT, 0, 0, 0.1) ;
    tensor_set(saT, 0, 1, 0.2) ;
    tensor_set(saT, 0, 2, (0.0 - 0.3)) ;

    requires_grad(saA) ;
    int saY = tensor_sum_rows(saA) ;
    // forward values: column sums are 1.3, -0.8, -0.3
    double f0 = tensor_get(saY, 0, 0) ;
    double f1 = tensor_get(saY, 0, 1) ;
    double f2 = tensor_get(saY, 0, 2) ;
    double fd = dabs(f0 - 1.3) + dabs(f1 - (0.0 - 0.8)) + dabs(f2 - (0.0 - 0.3)) ;
    if (fd < tol) { print("PASS sum_axis0 forward") ; } else { print("FAIL" sum axis0 forward) ; } 
    int saL = mse_loss(saY, saT) ;
    backward(saL) ;
    int saG = tensor_grad(saA) ;

    maxdiff = 0.0 ;
    int qi = 0 ;
    while (qi < 2) {
        int qj = 0 ;
        while (qj < 3) {
            double orig = tensor_get(saA, qi, qj) ;
            tensor_set(saA, qi, qj, orig + eps) ;
            int yP11 = tensor_sum_rows(saA) ;
            int lP11 = mse_loss(yP11, saT) ;
            double lossP = tensor_get(lP11, 0, 0) ;
            tensor_set(saA, qi, qj, orig - eps) ;
            int yM11 = tensor_sum_rows(saA) ;
            int lM11 = mse_loss(yM11, saT) ;
            double lossM = tensor_get(lM11, 0, 0) ;
            tensor_set(saA, qi, qj, orig) ;
            double numeric = (lossP - lossM) / (2.0 * eps) ;
            double analytic = tensor_get(saG, qi, qj) ;
            d = dabs(numeric - analytic) ;
            if (d > maxdiff) { maxdiff = d ; }
            qj = qj + 1 ;
        }
        qi = qi + 1 ;
    }
    if (maxdiff < tol) { print("PASS sum_axis0") ; } else { print("FAIL sum_axis0") ; }
}