# Lowering: int, float and double arithmetic, % on negatives, unary minus, conversions, compound assignment, and
# numbers declared without a value (they start at 0).
def half(double x) -> double:
    return x / 2.0

def avg(float a, float b) -> float:
    return (a + b) / 2.0

def mix(int n):
    double d = 0.5
    float f = 1.5
    return d * f

