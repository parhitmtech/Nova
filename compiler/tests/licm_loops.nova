# Loop-invariant code motion (--optimize): an invariant computation leaves the loop, and moving it never changes
# what the program prints. The suite runs this with and without --optimize, and both must print the same.
ignite:
    # (p + 1) and (p + 1) * 3 do not change in the loops over i and t: they move out, once per p
    int total = 0
    int p = 0
    while (p < 3):
        int i = 0
        while (i < 4):
            int t = 0
            while (t < 5):
                total = total + (p + 1) * 3 + i * t
                t = t + 1
            i = i + 1
        p = p + 1
    print(total)

    # y is read before the loop writes it: the first iteration must still see the old value
    int a = 5
    int y = 0
    int k = 0
    while (k < 3):
        print(y)
        y = a + 1
        k = k + 1

    # a loop that runs no times leaves x as it was
    int x = 7
    int n = 0
    while (n < 0):
        x = a + 2
        n = n + 1
    print(x)

    # a division that only runs when its divisor is not zero is not moved out
    int b = 0
    int q = 0
    int m = 0
    while (m < 2):
        if (b != 0):
            q = a / b
        m = m + 1
    print(q)

    # an invariant inside an if, and one used only inside the loop
    int s = 0
    int r = 0
    while (r < 6):
        if (r > 2):
            s = s + a * 4
        r = r + 1
    print(s)
