# Vector algorithms: sort, reverse, contains, index_of, binary_search, min, max, sum. Strings compare by
# their text.
def main():
    vector<int> v = vector<int>()
    v.push(5)
    v.push(1)
    v.push(4)
    v.push(1)
    print(v.contains(4))
    print(v.contains(9))
    print(v.index_of(1))
    print(v.index_of(7))
    print(v.min())
    print(v.max())
    print(v.sum())
    v.sort()
    print(v[0])
    print(v[3])
    print(v.binary_search(4))
    print(v.binary_search(3))
    v.reverse()
    print(v[0])

    vector<double> d = vector<double>()
    d.push(2.5)
    d.push(0.5)
    d.push(1.25)
    print(d.sum())
    print(d.max())
    d.sort()
    print(d[0])
    vector<float> f = vector<float>()
    f.push(1.5)
    f.push(0.25)
    float smallest = f.min()
    print(smallest)
    print(f.sum())

    vector<string> s = vector<string>()
    s.push("pear")
    s.push("apple")
    s.push("fig")
    s.sort()
    print(s[0])
    print(s[2])
    print(s.contains("fig"))
    print(s.index_of("pear"))
    print(s.binary_search("fig"))
    print(s.min())
    print(s.max())

    vector<int> empty = vector<int>()
    print(empty.sum())
