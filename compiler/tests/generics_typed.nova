# Types flow through generic copies: a copy's fields and method results, a class as a type argument, a container
# of a type parameter, and a generic function's result for each copy.
class Point:
    int x
    int y

    def init(int x, int y):
        self.x = x
        self.y = y

class Box<T>:
    T value

    def init(T v):
        self.value = v

    def get() -> T:
        return self.value

class Stack<T>:
    vector<T> items

    def init():
        self.items = vector<T>()

    def push(T v):
        self.items.push(v)

    def top() -> T:
        return self.items[self.items.size() - 1]

def biggest(a, b):
    if (a > b):
        return a
    return b

def main():
    Box<Point> bp = Box<Point>(Point(3, 4))
    Point p = bp.get()
    print(p.x + bp.value.y)
    Stack<double> s = Stack<double>()
    s.push(1.5)
    s.push(2.5)
    double d = s.top() * 2.0
    print(d)
    int m = biggest(3, 7)
    print(m)
    double e = biggest(1.5, 0.5)
    print(e)
