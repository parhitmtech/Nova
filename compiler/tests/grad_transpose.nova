def dabs(double x) -> double {
    if (x < 0.0) {
        return 0.0 - x ;
    }
    return x ;
}

main() {
    double eps = 0.0001 ;
    double tol = 0.001 ;
    double maxdiff = 0.0 ;
    double d = 0.0 ;

    // ── transpose ───────────────────────────────────────────────────────────
    int trA = tensor_zeros(2, 3) ;
    tensor_set(trA, 0, 0, 1.0) ;
    tensor_set(trA, 0, 1, (0.0 - 2.0)) ;
    tensor_set(trA, 0, 2, 0.5) ;
    tensor_set(trA, 1, 0, 0.3) ;
    tensor_set(trA, 1, 1, 1.2) ;
    tensor_set(trA, 1, 2, (0.0 - 0.8)) ;
    int trT = tensor_zeros(3, 2) ;
    tensor_set(trT, 0, 0, 0.1) ;
    tensor_set(trT, 0, 1, 0.2) ;
    tensor_set(trT, 1, 0, (0.0 - 0.3)) ;
    tensor_set(trT, 1, 1, 0.4) ;
    tensor_set(trT, 2, 0, 0.5) ;
    tensor_set(trT, 2, 1, (0.0 - 0.6)) ;

    requires_grad(trA) ;
    int trY = tensor_T(trA) ;
    int trL = mse_loss(trY, trT) ;
    backward(trL) ;
    int trG = tensor_grad(trA) ;

    maxdiff = 0.0 ;
    int pi = 0 ;
    while (pi < 2) {
        int pj = 0 ;
        while (pj < 3) {
            double orig = tensor_get(trA, pi, pj) ;
            tensor_set(trA, pi, pj, orig + eps) ;
            int yP10 = tensor_T(trA) ;
            int lP10 = mse_loss(yP10, trT) ;
            double lossP = tensor_get(lP10, 0, 0) ;
            tensor_set(trA, pi, pj, orig - eps) ;
            int yM10 = tensor_T(trA) ;
            int lM10 = mse_loss(yM10, trT) ;
            double lossM = tensor_get(lM10, 0, 0) ;
            tensor_set(trA, pi, pj, orig) ;
            double diff = lossP - lossM ;
            double twoEps = 2.0 * eps ;
            double numeric = diff / twoEps ;
            double analytic = tensor_get(trG, pi, pj) ;
            d = dabs(numeric - analytic) ;
            if (d > maxdiff) { maxdiff = d ; }
            pj = pj + 1 ;
        }
        pi = pi + 1 ;
    }
    if (maxdiff < tol) { print("PASS transpose") ; } else { print("FAIL transpose") ; }
}