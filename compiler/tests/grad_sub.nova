def dabs(double x) -> double:
    if (x < 0.0):
        return 0.0 - x
    return x

ignite:
    double eps = 0.0001
    double tol = 0.001
    double maxdiff = 0.0
    double d = 0.0

    # ── sub: C = A - B, grad wrt A ─────────────────────────────────────────
    Tensor suA = tensor_zeros(2, 2)
    tensor_set(suA, 0, 0, 1.0)
    tensor_set(suA, 0, 1, (0.0 - 2.0))
    tensor_set(suA, 1, 0, 0.5)
    tensor_set(suA, 1, 1, 3.0)
    Tensor suB = tensor_zeros(2, 2)
    tensor_set(suB, 0, 0, 0.3)
    tensor_set(suB, 0, 1, 1.0)
    tensor_set(suB, 1, 0, (0.0 - 1.5))
    tensor_set(suB, 1, 1, 0.7)
    Tensor suT = tensor_zeros(2, 2)
    tensor_set(suT, 0, 0, 0.1)
    tensor_set(suT, 0, 1, 0.2)
    tensor_set(suT, 1, 0, (0.0 - 0.3))
    tensor_set(suT, 1, 1, 0.4)

    requires_grad(suA)
    Tensor suY = tensor_sub(suA, suB)
    Tensor suL = mse_loss(suY, suT)
    backward(suL)
    Tensor suG = tensor_grad(suA)

    maxdiff = 0.0
    int si = 0
    while (si < 2):
        int sj = 0
        while (sj < 2):
            double orig = tensor_get(suA, si, sj)
            tensor_set(suA, si, sj, orig + eps)
            Tensor yP3 = tensor_sub(suA, suB)
            Tensor lP3 = mse_loss(yP3, suT)
            double lossP = tensor_get(lP3, 0, 0)
            tensor_set(suA, si, sj, orig - eps)
            Tensor yM3 = tensor_sub(suA, suB)
            Tensor lM3 = mse_loss(yM3, suT)
            double lossM = tensor_get(lM3, 0, 0)
            tensor_set(suA, si, sj, orig)
            double numeric = (lossP - lossM) / (2.0 * eps)
            double analytic = tensor_get(suG, si, sj)
            d = dabs(numeric - analytic)
            if (d > maxdiff): maxdiff = d
            sj = sj + 1
        si = si + 1
    if (maxdiff < tol): print("PASS sub")
    else: print("FAIL sub")
