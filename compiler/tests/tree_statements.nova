# The parse tree (--dump-tree): every kind of definition and statement. The tree records only what the source
# says, so "Point p" is a declaration because a name follows a type, not because Point is a known struct.
struct Point:
    int x
    int y

class Animal:
    int legs[4]

    def speak(self) -> int:
        return 0

class Dog extends Animal:
    pass

class Box<T>:
    T value

def halves(Tensor t) -> Tensor, Tensor:
    return t, t

def scale(x, k):
    return x * k

ignite:
    int n
    Point p = Point(1, 2)
    Box<vector<int>> b = Box<vector<int>>(vector<int>())
    Tensor a, Tensor c = halves(zeros(2, 2))
    n = input()
    p.x += 3
    if (n > 0): print(n)
    elif (n == 0):
        pass
    else:
        print("negative")
    while (n < 3):
        n += 1
    do: n -= 1
    while (n > 0)
    for (i = 0; i < 3; i += 1):
        if (i == 1): continue
        if (i == 2): break
    switch (n):
        case 5:
            print(5)
        default: print(0)
