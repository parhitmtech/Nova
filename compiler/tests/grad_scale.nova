def dabs(double x) -> double:
    if (x < 0.0):
        return 0.0 - x
    return x

ignite:
    double eps = 0.0001
    double tol = 0.001
    double maxdiff = 0.0
    double d = 0.0

    # ── scale: C = A * s (constant s), grad wrt A ──────────────────────────
    Tensor scA = tensor_zeros(2, 2)
    tensor_set(scA, 0, 0, 1.0)
    tensor_set(scA, 0, 1, (0.0 - 2.0))
    tensor_set(scA, 1, 0, 0.5)
    tensor_set(scA, 1, 1, 3.0)
    Tensor scT = tensor_zeros(2, 2)
    tensor_set(scT, 0, 0, 0.1)
    tensor_set(scT, 0, 1, 0.2)
    tensor_set(scT, 1, 0, (0.0 - 0.3))
    tensor_set(scT, 1, 1, 0.4)
    double scS = 2.5

    requires_grad(scA)
    Tensor scY = tensor_scale(scA, scS)
    Tensor scL = mse_loss(scY, scT)
    backward(scL)
    Tensor scG = tensor_grad(scA)

    maxdiff = 0.0
    int ci = 0
    while (ci < 2):
        int cj = 0
        while (cj < 2):
            double orig = tensor_get(scA, ci, cj)
            tensor_set(scA, ci, cj, orig + eps)
            Tensor yP5 = tensor_scale(scA, scS)
            Tensor lP5 = mse_loss(yP5, scT)
            double lossP = tensor_get(lP5, 0, 0)
            tensor_set(scA, ci, cj, orig - eps)
            Tensor yM5 = tensor_scale(scA, scS)
            Tensor lM5 = mse_loss(yM5, scT)
            double lossM = tensor_get(lM5, 0, 0)
            tensor_set(scA, ci, cj, orig)
            double numeric = (lossP - lossM) / (2.0 * eps)
            double analytic = tensor_get(scG, ci, cj)
            d = dabs(numeric - analytic)
            if (d > maxdiff): maxdiff = d
            cj = cj + 1
        ci = ci + 1
    if (maxdiff < tol): print("PASS scale")
    else: print("FAIL scale")
