# M1 stage 3: batched matmul. (2,3,4) @ (2,4,5) -> (2,3,5), one matmul per batch index,
# checked against NumPy (expected values computed with numpy.matmul). Non-square on purpose.
# Also a 4-D case, and the same result with autograd on and off.
ignite:
    Tensor A = tensor_zeros(2, 3, 4)
    Tensor B = tensor_zeros(2, 4, 5)
    int p = 0
    while (p < 2):
        int i = 0
        while (i < 3):
            int t = 0
            while (t < 4):
                tensor_set(A, p, i, t, (p + 1) * (i - t) + 1)
                t = t + 1
            i = i + 1
        int u = 0
        while (u < 4):
            int j = 0
            while (j < 5):
                tensor_set(B, p, u, j, (p - 1) * u + 2 * j - 1)
                j = j + 1
            u = u + 1
        p = p + 1

    Tensor C = matmul(A, B)
    print(tensor_rank(C))  # 3
    print(tensor_dim(C, 1))  # 3
    print(tensor_dim(C, 2))  # 5
    tensor_print(C)

    # 4-D: (2,2,2,3) @ (2,2,3,2) of ones: every entry is 3
    Tensor X = tensor_ones(2, 2, 2, 3)
    Tensor Y = tensor_ones(2, 2, 3, 2)
    Tensor Z = matmul(X, Y)
    print(tensor_rank(Z))  # 4
    print(tensor_get(Z, 1, 1, 1, 1))  # 3

    # autograd on must give the same forward result
    double off = tensor_sum(C)
    requires_grad(A)
    requires_grad(B)
    double on = tensor_sum(matmul(A, B))
    if (on == off): print("PASS bmm autograd forward")
    else: print("FAIL bmm autograd forward")
