# ── Node.js ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Frontend build ──
frontend/dist/

# ── Compiler build outputs ──
compiler/build/
compiler/_test_*/
*.o
*.nbc
