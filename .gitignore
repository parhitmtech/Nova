/*.asm
compiler/*.asm

# ── Server runtime data ──
server/_tmp/
server/workspace/
server/*.log
server/dist/

# ── Environment / secrets ──
.env
.env.*
!.env.example

# ── SSH / credentials ──
*.pem
*.key
sol_tunnel.pid
sol_tunnel_job.txt

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── Scratch files ──
*.csl
examples/*.csv

# ── CUDA build artifacts ──
*.cubin
*.ptx

# ── Editors / OS ──
.vscode/
.idea/
.DS_Store

