{
  "comments": { "lineComment": "#" },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "folding": { "offSide": true },
  "indentationRules": {
    "increaseIndentPattern": "^.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(else|elif|case|default)\\b.*:\\s*(#.*)?$"
  },
  "onEnterRules": [
    { "beforeText": "^\\s*(?:def|class|struct|if|elif|else|while|for|do|switch|case|default|ignite)\\b.*:\\s*(#.*)?$", "action": { "indent": "indent" } },
    { "beforeText": "^\\s+(?:return|break|continue|pass)\\b.*$", "action": { "indent": "outdent" } }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?"
}
