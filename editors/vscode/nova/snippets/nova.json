{
  "Entry point": {
    "prefix": "ignite",
    "body": ["ignite:", "\t$0"],
    "description": "The program's entry point: the ignite block, at the end of the file"
  },
  "Function": {
    "prefix": "def",
    "body": ["def ${1:name}(${2:int x}) -> ${3:int}:", "\t${0:return x}"],
    "description": "A function with typed parameters and a return type"
  },
  "Generic function": {
    "prefix": "defg",
    "body": ["def ${1:name}(${2:a}, ${3:b}):", "\t${0:return a}"],
    "description": "A generic function: untyped parameters, compiled once for each combination of argument types"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "\t${2:int} ${3:value}",
      "",
      "\tdef init(${2:int} ${4:v}):",
      "\t\tself.${3:value} = ${4:v}",
      "$0"
    ],
    "description": "A class with a field and its constructor (init)"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name}:", "\t${2:int} ${3:x}", "\t${4:int} ${5:y}", "$0"],
    "description": "A struct: a value with fields"
  },
  "If": {
    "prefix": "if",
    "body": ["if (${1:condition}):", "\t$0"],
    "description": "if: the condition in parentheses"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": ["if (${1:condition}):", "\t${2:pass}", "else:", "\t$0"],
    "description": "if, then else"
  },
  "While": {
    "prefix": "while",
    "body": ["while (${1:condition}):", "\t$0"],
    "description": "A while loop"
  },
  "For": {
    "prefix": "for",
    "body": ["for (${1:i} = ${2:0}; ${1:i} < ${3:n}; ${1:i} += 1):", "\t$0"],
    "description": "A for loop: start; condition; step"
  },
  "Switch": {
    "prefix": "switch",
    "body": ["switch (${1:value}):", "\tcase ${2:1}:", "\t\t$0", "\tdefault:", "\t\tpass"],
    "description": "A switch on an int, with its cases"
  },
  "Vector": {
    "prefix": "vector",
    "body": ["vector<${1:int}> ${2:v} = vector<${1:int}>()"],
    "description": "A new, empty vector"
  },
  "Map": {
    "prefix": "map",
    "body": ["map<${1:string}, ${2:int}> ${3:m} = map<${1:string}, ${2:int}>()"],
    "description": "A new, empty map"
  },
  "Training loop": {
    "prefix": "train",
    "body": [
      "orbit novatorch.nn",
      "",
      "ignite:",
      "\tTensor x = randn(${1:4}, ${2:2})",
      "\tTensor W = randn(${2:2}, ${3:1})",
      "\trequires_grad(W)",
      "\tint epoch = 0",
      "\tfor (epoch = 0; epoch < ${4:100}; epoch += 1):",
      "\t\tTensor loss = mse_loss(x @ W, zeros(${1:4}, ${3:1}))",
      "\t\tbackward(loss)",
      "\t\tgrad_step(W, ${5:0.01})",
      "\t\tzero_grad(W)",
      "\t$0"
    ],
    "description": "A small training loop: forward, loss, backward, step"
  }
}
