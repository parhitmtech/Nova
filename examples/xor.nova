# @ml
orbit novatorch.nn

ignite:
    Tensor X = zeros(4, 2)
    X[0, 0] = 0
    X[0, 1] = 0
    X[1, 0] = 0
    X[1, 1] = 1
    X[2, 0] = 1
    X[2, 1] = 0
    X[3, 0] = 1
    X[3, 1] = 1

    Tensor Y = zeros(4, 1)
    Y[0, 0] = 0
    Y[1, 0] = 1
    Y[2, 0] = 1
    Y[3, 0] = 0

    Linear layer1 = Linear(2, 4)

    Linear layer2 = Linear(4, 1)

    Sigmoid act1 = Sigmoid()

    Sigmoid act2 = Sigmoid()

    double lr = 0.5
    int epoch = 0
    Tensor h1
    Tensor a1
    Tensor h2
    Tensor pred

    int bar = progress_bar(10000, 40)

    while (epoch < 10000):
        h1   = layer1.forward(X)
        a1   = act1.forward(h1)
        h2   = layer2.forward(a1)
        pred = act2.forward(h2)

        Tensor grad  = mse_grad(pred, Y)
        double loss = mse_loss(pred, Y)[0, 0]
        progress_update(bar, epoch, loss)
        Tensor g2    = act2.backward(grad)
        Tensor dW2   = layer2.get_dW(g2)
        Tensor db2   = tensor_sum_rows(g2)

        # Propagate back through layer2 BEFORE updating layer2.W
        Tensor g1    = layer2.backward(g2)
        Tensor ga1   = act1.backward(g1)
        Tensor dW1   = layer1.get_dW(ga1)
        Tensor db1   = tensor_sum_rows(ga1)

        # Update all weights after all gradients are computed
        layer2.W = layer2.W - lr * dW2
        layer2.b = layer2.b - lr * db2
        layer1.W = layer1.W - lr * dW1
        layer1.b = layer1.b - lr * db1

        epoch = epoch + 1
    progress_done(bar)
    h1   = layer1.forward(X)
    a1   = act1.forward(h1)
    h2   = layer2.forward(a1)
    pred = act2.forward(h2)

    tensor_print(pred)
