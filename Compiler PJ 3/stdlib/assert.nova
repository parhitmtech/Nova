def assert_eq(int a, int b) -> int {
    if a > b {
        return 0 ;
    }
    if b < a {
        return 0;
    }
    return 1;
}

def assert_gt(int a, int b) -> int {
    if a > b {
        return 1 ;
    }
    return 0 ;
}

def assert_lt(int a, int b) -> int {
    if a < b {
        return 1 ;
    }
    return 0 ;
}