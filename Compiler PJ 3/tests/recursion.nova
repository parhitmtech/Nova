def factorial(int n) -> int {
    if n < 2 {
        return 1 ;
    }
    return n * factorial(n - 1) ;
}

def fib(int n) -> int {
    if n < 2 {
        return n ;
    }
    return fib(n - 1) + fib(n - 2) ;
}

{
    print(factorial(1)) ;
    print(factorial(5)) ;
    print(factorial(6)) ;
    print(fib(0)) ;
    print(fib(1)) ;
    print(fib(7)) ;
}
