class Counter {
    int count ;

    def init() {
        self.count = 0 ;
    }

    def increment() {
        self.count = self.count + 1 ;
    }

    def add(int n) {
        self.count = self.count + n ;
    }

    def get() -> int {
        return self.count ;
    }

    def reset() {
        self.count = 0 ;
    }
}

{
    Counter c ;
    c.init() ;
    print(c.get()) ;
    c.increment() ;
    c.increment() ;
    print(c.get()) ;
    c.add(10) ;
    print(c.get()) ;
    c.reset() ;
    print(c.get()) ;
}
