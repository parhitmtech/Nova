# Generate a new value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=3001
AWS_REGION=us-east-1
S3_BUCKET=novacomp-files
DYNAMODB_TABLE_USERS=novacomp-users
DYNAMODB_TABLE_AGENT_HISTORY=novacomp-agent-history
DYNAMODB_TABLE_AGENT_MEMORY=novacomp-agent-memory
NOVA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
NOVA_EXECUTION_MODE=docker
NOVA_WORKER_IMAGE=novacomp-worker:local
# Set local only for trusted development code, never for a public server.
NOVA_ENABLE_GPU=false
