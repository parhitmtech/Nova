import <novatorch.nn> ;
import <novatorch.optim> ;

main() {
    // Dataset: AND gate — simplest linearly separable binary problem
    // Input: 4x2,  Label: 1 only when both inputs are 1
    int X = tensor_zeros(4, 2) ;
    tensor_set(X, 0, 0, 0) ; 
    tensor_set(X, 0, 1, 0) ;
    tensor_set(X, 1, 0, 0) ; 
    tensor_set(X, 1, 1, 1) ;
    tensor_set(X, 2, 0, 1) ; 
    tensor_set(X, 2, 1, 0) ;
    tensor_set(X, 3, 0, 1) ; 
    tensor_set(X, 3, 1, 1) ;

    int Y = tensor_zeros(4, 1) ;
    tensor_set(Y, 0, 0, 0) ;
    tensor_set(Y, 1, 0, 0) ;
    tensor_set(Y, 2, 0, 0) ;
    tensor_set(Y, 3, 0, 1) ;

    // Model: Linear(2→1) → Sigmoid
    Linear layer1 ;
    layer1.init(2, 1) ;

    Sigmoid sig1 ;
    sig1.init() ;

    SGD optim ;
    optim.init(0.5) ;

    int epoch = 0 ;
    int z    = 0 ;
    int pred = 0 ;

    while epoch < 10000 {
        // Forward
        z    = layer1.forward(X) ;
        pred = sig1.forward(z) ;

        // Backward — BCE grad (sigmoid cancels cleanly, pred - Y)
        int grad = bce_grad(pred, Y) ;
        int dW        = layer1.get_dW(grad) ;
        int db        = tensor_sum_rows(grad) ;

        layer1.W = optim.step(layer1.W, dW) ;
        layer1.b = optim.step(layer1.b, db) ;

        epoch = epoch + 1 ;
    }

    // Expected: ~[[0], [0], [0], [1]]
    z    = layer1.forward(X) ;
    pred = sig1.forward(z) ;
    tensor_print(pred) ;
}