main() {
    arr = array(5) ;
    arr[0] = 10 ;
    arr[1] = 20 ;
    arr[2] = 30 ;
    arr[3] = 40 ;
    arr[4] = 50 ;
    print(arr[0]) ;
    print(arr[2]) ;
    print(arr[4]) ;

    sum = 0 ;
    i = 0 ;
    while i < 5 {
        sum = sum + arr[i] ;
        i = i + 1 ;
    }
    print(sum) ;

    arr[2] = arr[0] + arr[1] ;
    print(arr[2]) ;
}
