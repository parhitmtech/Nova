class Stack {
    int data[256];
    int top ;

    def init() {
        self.top = -1 ;
    }

    def push(int val) {
        self.top = self.top + 1 ;
        self.data[self.top] = val ;
    }

    def pop() -> int {
        int result = 0 ;
        result = self.data[self.top] ;
        self.top = self.top - 1 ;
        return result;
    }

    def peek() -> int {
        return self.data[self.top] ;
    }

    def size() -> int {
        return self.top + 1 ;
    }

    def isEmpty() -> int {
        int r = 0 ;
        if self.top < 0 {
            r = 1 ;
        }
        return r ;
    }
}

class Queue {
    int data[256] ;
    int head ;
    int tail ;
    int count ;

    def init() {
        self.head = 0 ;
        self.tail = 0 ;
        self.count = 0 ;
    }

    def enqueue(int val) {
        self.data[self.tail] = val ;
        self.tail = self.tail + 1 ;
        self.count = self.count + 1;
    }

    def dequeue() -> int {
        int result = 0 ;
        result = self.data[self.head] ;
        self.head = self.head + 1 ;
        self.count = self.count - 1 ;
        return result ;
    }

    def size() -> int {
        return self.count ;
    }

    def isEmpty() -> int {
        int r = 0 ;
        if self.count < 1 {
            r = 1 ;
        }
        return r ;
    }
}